# Copy to .env for local development. .env is gitignored and never committed.
PORT=3000
NODE_ENV=development

# Bearer token required by GET /api/admin/stats. Leave blank to keep it closed.
ADMIN_TOKEN=

# One browser origin allowed for cross-origin API calls (never a wildcard).
# Leave blank for same-origin only, which is what the bundled UI uses.
CORS_ORIGIN=
